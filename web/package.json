{
  "name": "phuquoclux-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "typecheck": "react-router typegen && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm run test:domain && npm run build && wrangler deploy --dry-run",
    "test:domain": "tsx scripts/domain-check.mjs && tsx scripts/supplier-intake-selftest.mjs && tsx scripts/payment-provider-contract-v1.mjs && tsx scripts/payment-webhook-processor-v1.mjs && tsx scripts/payment-provider-registry-v1.mjs && tsx scripts/payment-runtime-gate-v1.mjs && node scripts/commerce-production-lock-v1.mjs",
    "test:visual": "playwright test",
    "build:pages": "vite build --config vite.pages.config.ts",
    "dev:pages": "vite --config vite.pages.config.ts --host 127.0.0.1 --port 4174",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "supplier:template": "tsx scripts/supplier-intake-check.mjs --template",
    "supplier:check": "tsx scripts/supplier-intake-check.mjs",
    "test:db": "tsx scripts/postgres-booking-integration.mjs && node scripts/postgres-payment-upgrade-preflight-v1.mjs && tsx scripts/postgres-payment-contract-v1.mjs",
    "test:payment-contract": "node scripts/postgres-payment-upgrade-preflight-v1.mjs && tsx scripts/postgres-payment-contract-v1.mjs",
    "test:payment-upgrade-preflight": "node scripts/postgres-payment-upgrade-preflight-v1.mjs",
    "test:payment-provider-contract": "tsx scripts/payment-provider-contract-v1.mjs",
    "test:payment-webhook-processor": "tsx scripts/payment-webhook-processor-v1.mjs",
    "test:payment-provider-registry": "tsx scripts/payment-provider-registry-v1.mjs",
    "test:payment-runtime-gate": "tsx scripts/payment-runtime-gate-v1.mjs",
    "test:commerce-production-lock": "node scripts/commerce-production-lock-v1.mjs",
    "db:migrate:plan": "node scripts/postgres-migrate.mjs --plan",
    "db:migrate": "node scripts/postgres-migrate.mjs --apply"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "isbot": "5.1.32",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@react-router/dev": "8.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "^4.143.0",
    "tsx": "^4.20.6",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1"
  }
}
