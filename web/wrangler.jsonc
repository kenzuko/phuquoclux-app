{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phuquoclux-app",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-29",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "myphuquoc.com",
      "custom_domain": true
    },
    {
      "pattern": "www.myphuquoc.com",
      "custom_domain": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e5470089fa104a0fb3221d9769ec9474"
    }
  ],
  "vars": {
    "MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty",
    "WEATHER_RUNTIME_BASE_URL": "https://weather.openphuquoc.com",
    "COMMERCE_MODE": "prototype",
    "MANAGE_BOOKING_EXCHANGE_ENABLED": "false"
  }
}
